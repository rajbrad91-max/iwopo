#!/bin/bash
# Verify, commit, and put it live — one command.
#
# This was forty lines rewritten by hand for every single change, which is
# both slow and how steps get quietly dropped: a stylesheet went out truncated
# because the diff was never read, and a deploy once ran with the verify step
# missing entirely. The order here is fixed and cannot be skipped — nothing is
# committed until the build, the lint and the diff-sanity check have passed.
#
#   iwopo-deploy /tmp/msg.txt          commit message from a file
#   iwopo-deploy --check               verify only, change nothing
set -e
S=/var/www/iwopo-staging
L=/var/www/iwopo

# ─────────────────────────────────────────────────────────────────────────
# 🔒 GALLERIES ARE LOCKED.
#
# Raj's instruction, made into a rule rather than something either of us has
# to remember. The gallery code is years old, carries every wedding already
# delivered, and is the one part of the product where a regression is not
# recoverable — a couple's photographs are not something you restore from a
# backup and apologise for.
#
# Live shoot shares a lot of it: the same upload route, the same stylesheet,
# the same public album lookup. So a live shoot change CAN touch these files
# by accident, and has: the two-tier change edited albums.js, correctly, but
# one careless line there would have changed how galleries store originals.
#
# This refuses the deploy unless the change says out loud that it means to.
# Set GALLERY_OK=1 for a deliberate gallery change.
GALLERY_FILES="frontend/src/pages/PublicGallery.jsx frontend/src/pages/VendorGallery.jsx frontend/src/pages/gallery.css backend/src/routes/galleryPublic.js"

TOUCHED=""
for f in $GALLERY_FILES; do
  if ! git -C $S diff --quiet -- "$f" 2>/dev/null; then TOUCHED="$TOUCHED $f"; fi
done

if [ -n "$TOUCHED" ] && [ "$GALLERY_OK" != "1" ]; then
  echo "🔒 GALLERY CODE CHANGED — refusing to deploy"
  echo
  for f in $TOUCHED; do
    echo "   $f"
    git -C $S diff --stat -- "$f" | head -1 | sed 's/^/     /'
  done
  echo
  echo "   Galleries are locked. If this is deliberate:  GALLERY_OK=1 iwopo-deploy <msg>"
  echo "   If it is not, undo it:                        git checkout --$TOUCHED"
  exit 1
fi
[ -n "$TOUCHED" ] && echo "🔓 gallery change allowed by GALLERY_OK=1:$TOUCHED"

echo "═══ VERIFY ═══"
cd $S/frontend
BUILD=$(npm run build 2>&1)
echo "$BUILD" | grep -qE "error|Error:" && { echo "$BUILD" | tail -20; echo "❌ BUILD FAILED — nothing committed"; exit 1; }
echo "  build: $(echo "$BUILD" | grep -oE '✓ built in [0-9.]+s')"
cd $S
LINT=$(npx eslint backend/src frontend/src 2>&1 | tail -1)
echo "$LINT" | grep -qE "[1-9][0-9]* error" && { echo "  $LINT"; echo "❌ LINT ERRORS — nothing committed"; exit 1; }
echo "  lint: ${LINT:-clean}"

# a file that loses far more than it gains is how a stylesheet gets truncated
TRUNC=$(git diff --numstat | awk '$2 > 200 && $1 < ($2/10) {print $3 " lost " $2 " gained " $1}')
if [ -n "$TRUNC" ]; then
  if [ "$1" = "--force-truncation" ] && [ -n "$2" ]; then
    echo "  ⚠️  $TRUNC"
    echo "  ↳ override: $2"
    FORCED="$2"
    shift 2
  else
    echo "  ⚠️  $TRUNC"
    echo "❌ A file lost most of itself. Read that diff. Nothing committed."
    echo "   If the drop is deliberate and you have read the diff:"
    echo "   iwopo-deploy --force-truncation \"why\" <message-file>"
    exit 1
  fi
fi
echo "  diff sanity: ok"

if [ "$1" = "--check" ]; then echo "═══ CHECK ONLY — nothing changed ═══"; exit 0; fi
[ -z "$1" ] || [ ! -f "$1" ] && { echo "usage: iwopo-deploy <message-file> | --check"; exit 1; }

echo
echo "═══ COMMIT + PUSH ═══"
cd $S
git add -A
if [ -n "$FORCED" ]; then
  printf '%s\n\n[diff-sanity override] %s\n' "$(cat "$1")" "$FORCED" > /tmp/_msg
  git commit -F /tmp/_msg && rm -f /tmp/_msg
else
  git commit -F "$1"
fi | head -2
echo "  staging: $(git rev-parse --short HEAD)"
git push -q origin staging
git checkout -q main && git merge -q staging && git push -q origin main && git checkout -q staging
echo "  main: pushed"

echo
echo "═══ LIVE ═══"
cd $L
git pull -q origin main

# ⚠️ Always, not only when the schema looks changed.
#
# This step was done by hand and therefore forgotten, four times in one day.
# It stayed invisible until code actually USED a new column, and then live
# returned 500 on every request that touched it — the client had been twelve
# hours behind its own schema. Detecting whether the schema moved would be a
# conditional that can be got wrong; regenerating unconditionally costs about
# six hundred milliseconds on a deploy that already takes twenty seconds, and
# cannot be skipped.
#
# Before the restart, deliberately: the running process loads the client at
# boot, so regenerating after it would take effect on the NEXT deploy.
cd $L/backend
# 🧠 Face models — too big for git, so fetched once per machine and checked by
# their SHA-256 before use: a half-downloaded or tampered model never runs.
#   AuraFace (fal.ai, Apache-2.0)        — who is who
#   YuNet (OpenCV Zoo, MIT)               — finds faces and their 5 points
#   Face Mesh (Google MediaPipe, Apache-2.0) — eyes open / head angle, for covers
fetch_model() {
  local dest=$1 url=$2 sum=$3
  if [ -s "$dest" ] && [ "$(sha256sum "$dest" | cut -c1-64)" = "$sum" ]; then return; fi
  mkdir -p "$(dirname "$dest")"
  curl -sL -o "$dest.part" "$url"
  if [ "$(sha256sum "$dest.part" | cut -c1-64)" = "$sum" ]; then mv "$dest.part" "$dest"; echo "  model fetched: $dest"
  else rm -f "$dest.part"; echo "  ❌ $dest: download did not match its checksum — faces will not index until this is fixed"; fi
}
fetch_model models/auraface/glintr100.onnx https://huggingface.co/fal/AuraFace-v1/resolve/main/glintr100.onnx a7933ea5330113b01c9b60351d8f4c33003f145d8470ac5f0e52ee2effe25c60
fetch_model models/yunet/face_detection_yunet_2023mar.onnx https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx 8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
fetch_model models/facemesh/face_landmarks_detector.onnx https://huggingface.co/senty-au/face_landmarks_detector-ONNX/resolve/main/onnx/model.onnx 7d6e82dee82a1dca5fbddb282b3cc74571833a530de317fc22ae325c3358beeb
# packages follow package-lock.json exactly (a removed library really goes)
npm ci --no-audit --no-fund 2>&1 | tail -1 | sed 's/^/  npm: /'
# 🗄️ Database changes come from Prisma's migration history (prisma/migrations
# and prisma/private/migrations), not from hand-written ALTERs that depend on
# somebody remembering them. `migrate deploy` applies only migrations live has
# not had yet, in order, and does nothing else — it never drops, resets or
# guesses. Before the restart, so the new code never meets an old table.
npx prisma migrate deploy 2>&1 | grep -E 'applied|No pending|Error' | sed 's/^/  iwopo db: /'
npx prisma migrate deploy --config prisma.private.config.ts 2>&1 | grep -E 'applied|No pending|Error' | sed 's/^/  private db: /'
npx prisma generate 2>&1 | grep -oE 'Generated Prisma Client.*in [0-9]+ms' | sed 's/^/  prisma: /'
npx prisma generate --config prisma.private.config.ts 2>&1 | grep -oE 'Generated Prisma Client.*in [0-9]+ms' | sed 's/^/  prisma (private): /'
cd $L/frontend && npm run build 2>&1 | grep -oE '✓ built in [0-9.]+s' | sed 's/^/  build: /'
systemctl reload nginx
# --cwd: without it pm2 can keep the process rooted in a stale directory
pm2 restart iwopo-api --cwd $L/backend --update-env >/dev/null 2>&1
sleep 4

echo
echo "═══ PARITY ═══"
for d in $L $S; do cd $d; echo "  $(basename $d) @ $(git rev-parse --short HEAD) uncommitted=$(git status --porcelain|wc -l)"; done
diff -rq $L/frontend/src $S/frontend/src >/dev/null && echo "  frontend/src identical" || echo "  ⚠️  frontend/src DIFFERS"
# src/generated is built per machine from the schema — not part of the comparison
diff -rq -x generated $L/backend/src $S/backend/src >/dev/null && echo "  backend/src identical" || echo "  ⚠️  backend/src DIFFERS"
for d in $L $S; do cd $d/backend; echo "  $(basename $d) migrations: $(npx prisma migrate status 2>&1 | grep -oE 'Database schema is up to date|have not yet been applied|drift' | head -1) · private: $(npx prisma migrate status --config prisma.private.config.ts 2>&1 | grep -oE 'Database schema is up to date|have not yet been applied|drift' | head -1)"; done
a=$(grep -o 'assets/[^"]*\.js' $L/frontend/dist/index.html|head -1); b=$(grep -o 'assets/[^"]*\.js' $S/frontend/dist/index.html|head -1)
[ "$a" = "$b" ] && echo "  bundle identical" || echo "  ⚠️  bundle DIFFERS"
echo "  iwopo.com $(curl -s -o /dev/null -w '%{http_code}' https://iwopo.com/)  alphabetaone.com $(curl -s -o /dev/null -w '%{http_code}' https://alphabetaone.com/)"
# a client older than the schema it is meant to match is the fault above,
# and it can arrive from any direction — a manual pull, a rollback, an npm ci
for d in $L $S; do
  sc=$(stat -c %Y $d/backend/prisma/schema.prisma)
  cl=$(stat -c %Y $d/backend/node_modules/.prisma/client/index.js 2>/dev/null || echo 0)
  [ "$cl" -lt "$sc" ] && echo "  ⚠️  $(basename $d): prisma client is OLDER than its schema — run npx prisma generate"
done
ERR=$(pm2 logs iwopo-api --err --lines 20 --nostream 2>/dev/null | grep -viE 'tensorflow|oneDNN|env vars|APP_URL|PLATFORM_SMTP|TAILING|error.log last' | grep -vE '^\s*$' | tail -3)
[ -n "$ERR" ] && echo "  ⚠️  $ERR" || echo "  error log clean"
